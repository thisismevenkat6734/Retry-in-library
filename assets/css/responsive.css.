   RETRY IN LIBRARY
   File: assets/css/responsive.css
   Responsive layout for mobile, tablet and desktop
   ========================================================= */

/* Large tablets and small laptops */

@media (max-width: 1100px) {

  :root {
    --container-width: 960px;
  }

  .header-container {
    gap: 12px;
  }

  .primary-navigation {
    gap: 12px;
  }

  .primary-navigation a {
    font-size: 0.8rem;
  }

  .brand-text strong {
    font-size: 0.9rem;
  }

  .brand-text small {
    font-size: 0.52rem;
  }

  .exam-grid,
  .subject-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 17px;
  }

  .trust-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Tablet */

@media (max-width: 900px) {

  :root {
    --header-height: 70px;
  }

  .container {
    width: min(100% - 32px, 760px);
  }

  .header-container {
    position: relative;
    flex-wrap: wrap;
  }

  .menu-toggle {
    display: block;
    order: 2;
    margin-left: auto;
  }

  .header-actions {
    order: 3;
  }

  .primary-navigation {
    display: none;
    position: absolute;
    top: calc(100% + 1px);
    left: 0;
    right: 0;
    z-index: 1001;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 0;
    border-radius: 0 0 12px 12px;
    box-shadow: var(--shadow-md);
  }

  .primary-navigation.active {
    display: flex;
  }

  .primary-navigation a {
    padding: 12px;
    border-radius: 7px;
    font-size: 0.95rem;
  }

  .primary-navigation a:hover {
    background: var(--primary-light);
  }

  .hero-section {
    padding-block: 70px;
  }

  .hero-container {
    grid-template-columns: 1fr 0.7fr;
    gap: 25px;
  }

  .hero-content h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .hero-book {
    width: 230px;
    min-height: 225px;
  }

  .exam-grid,
  .subject-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .practice-grid,
  .current-affairs-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .footer-container {
    gap: 25px;
  }
}

/* Mobile */

@media (max-width: 600px) {

  :root {
    --header-height: 66px;
  }

  body {
    font-size: 15px;
  }

  .container {
    width: calc(100% - 30px);
  }

  .section {
    padding-block: 55px;
  }

  .section-heading {
    margin-bottom: 27px;
    text-align: left;
  }

  .section-heading h2 {
    font-size: 1.65rem;
  }

  .section-heading p {
    font-size: 0.9rem;
  }

  /* Header */

  .header-container {
    min-height: var(--header-height);
    gap: 8px;
  }

  .brand {
    gap: 5px;
  }

  .brand-icon {
    width: 36px;
    height: 36px;
  }

  .brand-icon svg {
    width: 34px;
    height: 34px;
  }

  .brand-text strong {
    font-size: 0.79rem;
  }

  .brand-text small {
    max-width: 145px;
    font-size: 0.44rem;
    letter-spacing: 0.2px;
  }

  .menu-toggle {
    width: 38px;
    height: 38px;
    padding: 7px;
  }

  .header-actions {
    gap: 5px;
  }

  .header-actions button {
    min-width: 35px;
    min-height: 36px;
    padding: 5px 7px;
    font-size: 0.75rem;
  }

  .primary-navigation {
    max-height: calc(100vh - var(--header-height) - 20px);
    overflow-y: auto;
  }

  /* Hero */

  .hero-section {
    padding-block: 55px;
  }

  .hero-container {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .hero-content h1 {
    font-size: clamp(2rem, 9vw, 2.8rem);
    letter-spacing: -0.5px;
  }

  .hero-content p {
    font-size: 0.94rem;
  }

  .hero-label {
    font-size: 0.68rem;
  }

  .hero-actions {
    gap: 10px;
  }

  .hero-actions .btn {
    flex: 1 1 140px;
    padding-inline: 12px;
    font-size: 0.82rem;
  }

  .hero-visual {
    min-height: 220px;
  }

  .hero-book {
    width: 205px;
    min-height: 195px;
    padding: 20px;
  }

  .hero-book > span {
    width: 58px;
    height: 58px;
    font-size: 2.2rem;
  }

  .hero-book strong {
    font-size: 1.3rem;
  }

  .hero-book small {
    font-size: 0.55rem;
  }

  /* Search */

  .search-section {
    padding-block: 45px;
  }

  .search-section .section-heading {
    text-align: center;
  }

  #global-search {
    flex-direction: column;
  }

  #search-input {
    width: 100%;
    min-height: 49px;
  }

  #global-search .btn {
    width: 100%;
  }

  /* Cards */

  .exam-grid,
  .subject-grid,
  .practice-grid,
  .current-affairs-grid,
  .state-grid,
  .trust-grid {
    grid-template-columns: 1fr;
    gap: 15px;
  }

  .exam-card,
  .subject-card,
  .practice-card,
  .current-affairs-card {
    padding: 20px;
  }

  .exam-card p,
  .subject-card p,
  .practice-card p,
  .current-affairs-card p {
    min-height: auto;
  }

  .state-card {
    padding: 22px;
  }

  .state-card .btn {
    width: 100%;
  }

  .trust-grid article {
    padding: 20px;
    text-align: left;
  }

  .independence-notice {
    margin-top: 25px;
    font-size: 0.82rem;
    text-align: left;
  }

  /* Footer */

  .site-footer {
    padding-top: 40px;
  }

  .footer-container {
    grid-template-columns: 1fr;
    gap: 30px;
    padding-bottom: 30px;
  }

  .footer-links {
    gap: 9px;
  }

  .footer-bottom {
    padding-block: 16px;
  }

  .footer-bottom p {
    font-size: 0.75rem;
  }
}

/* Very small phones */

@media (max-width: 360px) {

  .container {
    width: calc(100% - 24px);
  }

  .brand-text strong {
    font-size: 0.7rem;
  }

  .brand-text small {
    max-width: 125px;
    font-size: 0.39rem;
  }

  .header-container {
    gap: 5px;
  }

  .menu-toggle {
    width: 34px;
    height: 34px;
  }

  .header-actions button {
    min-width: 32px;
    min-height: 34px;
    padding: 4px;
  }

  .hero-content h1 {
    font-size: 1.9rem;
  }

  .hero-actions .btn {
    flex-basis: 100%;
  }
}

/* Wide screens */

@media (min-width: 1400px) {

  :root {
    --container-width: 1280px;
  }

  .hero-section {
    padding-block: 110px;
  }

  .section {
    padding-block: 90px;
  }
}

/* Landscape mobile */

@media (max-width: 900px) and (orientation: landscape) {

  .primary-navigation {
    max-height: 70vh;
    overflow-y: auto;
  }

  .hero-section {
    padding-block: 40px;
  }

  .hero-container {
    grid-template-columns: 1fr 0.65fr;
  }
}

/* Print */

@media print {

  .menu-toggle,
  .primary-navigation,
  .header-actions,
  .hero-visual {
    display: none !important;
  }

  .container {
    width: 100%;
  }

  .hero-container {
    display: block;
  }

  .exam-grid,
  .subject-grid,
  .practice-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
