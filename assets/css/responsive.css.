/* =========================================
   RETRY IN LIBRARY
   Responsive Stylesheet
   Version: 1.0
========================================= */

/* TABLETS */

@media (max-width: 1024px) {

  .header-container {
    gap: 15px;
  }

  .primary-navigation {
    gap: 15px;
  }

  .primary-navigation a {
    font-size: 12px;
  }

  .hero-container {
    gap: 25px;
  }

  .subject-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .exam-grid {
    grid-template-columns: repeat(2, 1fr);
  }

}


/* SMALL TABLETS */

@media (max-width: 800px) {

  .header-container {
    min-height: 70px;
  }

  .menu-toggle {
    display: block;
    order: 3;
  }

  .header-actions {
    order: 2;
    margin-left: auto;
  }

  .primary-navigation {
    position: absolute;
    top: 70px;
    left: 0;
    right: 0;

    display: none;
    flex-direction: column;
    align-items: stretch;

    gap: 0;
    padding: 12px 20px 20px;

    background: var(--surface);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }

  .primary-navigation.active {
    display: flex;
  }

  .primary-navigation a {
    padding: 13px 8px;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }

  .primary-navigation a:last-child {
    border-bottom: 0;
  }

  .hero-container {
    grid-template-columns: 1fr;
    text-align: center;
    padding-block: 60px;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-description {
    max-width: 600px;
  }

  .hero-visual {
    margin-top: 15px;
  }

  .hero-book-card {
    width: 250px;
    min-height: 260px;
  }

  .footer-container {
    grid-template-columns: repeat(2, 1fr);
  }

}


/* MOBILE DEVICES */

@media (max-width: 600px) {

  html {
    scroll-padding-top: 75px;
  }

  .container,
  .header-container,
  .hero-container,
  .search-container,
  .footer-container,
  .trust-container {
    width: calc(100% - 30px);
  }

  .header-container {
    min-height: 65px;
    gap: 8px;
  }

  .brand-icon {
    width: 37px;
    height: 37px;
  }

  .brand-text strong {
    font-size: 17px;
    letter-spacing: .8px;
  }

  .brand-text small {
    font-size: 9px;
  }

  .primary-navigation {
    top: 65px;
  }

  .language-toggle,
  .theme-toggle {
    min-width: 34px;
    height: 35px;
    padding: 0 7px;
  }

  .language-toggle {
    font-size: 11px;
  }

  .theme-toggle {
    font-size: 16px;
  }

  .hero-container {
    min-height: auto;
    padding-block: 55px 45px;
    gap: 30px;
  }

  .hero-label {
    font-size: 9px;
    letter-spacing: 1.4px;
  }

  .hero-content h1 {
    font-size: 37px;
    letter-spacing: -1px;
    margin-bottom: 16px;
  }

  .hero-description {
    font-size: 13px;
    line-height: 1.8;
    margin-bottom: 23px;
  }

  .hero-actions {
    width: 100%;
    justify-content: center;
    gap: 10px;
  }

  .hero-actions .btn {
    padding: 11px 15px;
    font-size: 11px;
  }

  .hero-language-note {
    font-size: 10px;
    line-height: 1.8;
  }

  .hero-book-card {
    width: 220px;
    min-height: 235px;
    padding: 26px;
  }

  .hero-book-card strong {
    font-size: 25px;
  }

  .book-symbol {
    font-size: 35px;
    margin-bottom: 12px;
  }

  .search-section {
    padding-block: 30px;
  }

  .search-container {
    padding: 22px 15px;
    border-radius: 15px;
  }

  .search-heading h2 {
    font-size: 19px;
  }

  .search-heading p {
    font-size: 11px;
  }

  .search-form {
    flex-direction: column;
  }

  .search-form input {
    height: 46px;
    font-size: 12px;
  }

  .search-form .btn {
    width: 100%;
  }

  .content-section {
    width: calc(100% - 30px);
    padding: 45px 0;
  }

  .section-heading {
    margin-bottom: 25px;
  }

  .section-label {
    font-size: 9px;
    letter-spacing: 1.4px;
  }

  .section-heading h2 {
    font-size: 25px;
  }

  .section-heading p {
    font-size: 12px;
    line-height: 1.8;
  }

  .exam-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 11px;
  }

  .exam-card {
    min-height: 170px;
    padding: 17px 13px;
    border-radius: 12px;
  }

  .exam-icon {
    font-size: 24px;
  }

  .exam-card h3 {
    font-size: 15px;
  }

  .exam-card p {
    font-size: 10px;
  }

  .card-link {
    font-size: 10px;
    margin-top: 12px;
  }

  .subject-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .subject-card {
    min-height: 125px;
    padding: 15px 8px;
    border-radius: 12px;
  }

  .subject-card > span {
    font-size: 25px;
  }

  .subject-card strong {
    font-size: 11px;
  }

  .subject-card small {
    font-size: 10px;
  }

  .state-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .state-card {
    min-height: auto;
    padding: 25px;
  }

  .state-card h3 {
    font-size: 20px;
  }

  .state-card p {
    font-size: 12px;
  }

  .practice-section {
    width: calc(100% - 30px);
    padding: 35px 18px;
    margin-block: 25px;
  }

  .practice-content h2 {
    font-size: 27px;
  }

  .practice-content p {
    font-size: 12px;
  }

  .practice-features {
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-size: 11px;
  }

  .current-affairs-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .current-card {
    padding: 20px;
  }

  .trust-section {
    padding: 40px 0;
  }

  .trust-container h2 {
    font-size: 22px;
  }

  .trust-container p {
    font-size: 12px;
  }

  .footer-container {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .site-footer {
    padding-top: 40px;
  }

  .footer-bottom {
    flex-direction: column;
    gap: 8px;
    text-align: center;
  }

}


/* VERY SMALL MOBILE DEVICES */

@media (max-width: 360px) {

  .brand-text strong {
    font-size: 15px;
  }

  .brand-text small {
    font-size: 8px;
  }

  .header-actions {
    gap: 5px;
  }

  .hero-content h1 {
    font-size: 32px;
  }

  .hero-actions .btn {
    padding: 10px 11px;
    font-size: 10px;
  }

  .exam-card {
    padding: 14px 10px;
  }

}


/* LARGE DESKTOP */

@media (min-width: 1400px) {

  :root {
    --container: 1240px;
  }

  .hero-container {
    min-height: 530px;
  }

}


/* PRINT STYLES */

@media print {

  .site-header,
  .site-footer,
  .hero-actions,
  .search-section,
  .menu-toggle,
  .header-actions {
    display: none !important;
  }

  body {
    background: white;
    color: black;
  }

  .content-section {
    width: 100%;
    padding: 15px 0;
  }

  .exam-card,
  .subject-card {
    break-inside: avoid;
    box-shadow: none;
  }

}
